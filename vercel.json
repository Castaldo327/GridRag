{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "uv run --locked python -m scripts.vercel_build",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "data/warehouse.duckdb",
      "excludeFiles": "{.venv/**,.git/**,.env*,experimental/**,tests/**,docs/**,output/**,.interview-build/**,.mypy_cache/**,public/**}"
    }
  },
  "rewrites": [{ "source": "/api/:route*", "destination": "/api?route=:route*" }],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
    ]
  }]
}
